<?xml version="1.0" encoding="UTF-8"?>
<web-app metadata-complete="true" version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <!-- Thời gian hết hạn phiên làm việc (30 phút) -->
    <servlet-mapping>
        <servlet-name>AccountController</servlet-name>
        <url-pattern>/admin/accounts</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardController</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DoctorDashboardController</servlet-name>
        <url-pattern>/doctor/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DoctorExamineController</servlet-name>
        <url-pattern>/doctor/examine</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DoctorPrintController</servlet-name>
        <url-pattern>/doctor/print</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <!-- Cấu hình cứng cho ProfileController -->
    <servlet>
        <servlet-name>ProfileController</servlet-name>
        <servlet-class>controller.ProfileController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AccountController</servlet-name>
        <servlet-class>controller.AccountController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DashboardController</servlet-name>
        <servlet-class>controller.DashboardController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DoctorDashboardController</servlet-name>
        <servlet-class>controller.DoctorDashboardController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DoctorExamineController</servlet-name>
        <servlet-class>controller.DoctorExamineController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DoctorPrintController</servlet-name>
        <servlet-class>controller.DoctorPrintController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileController</servlet-name>
        <url-pattern>/Profile</url-pattern>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <!-- 2. Medicine Controller (Quản lý kho thuốc) -->
    <servlet>
        <servlet-name>MedicineController</servlet-name>
        <servlet-class>controller.MedicineController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MedicineController</servlet-name>
        <url-pattern>/admin/medicines</url-pattern>
    </servlet-mapping>
</web-app>
